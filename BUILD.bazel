        "WIFI/work.c",
        "WIFI/vendor.c",
        "WIFI/tcp_ack.c",
        "WIFI/mm.c",
        "WIFI/reorder.c",
        "WIFI/wl_core.c",
        "WIFI/tx_msg.c",
        "WIFI/rx_msg.c",
        "WIFI/wl_intf.c",
        "WIFI/qos.c",
        "WIFI/dbg_ini_util.c",
        "WIFI/reg_domain.c",
        "WIFI/defrag.c",
        "WIFI/ibss.c",
        "WIFI/nan.c",
        "WIFI/tracer.c",
        "WIFI/rf_marlin3.c",
        "WIFI/rtt.c",
        "WIFI/api_version.c",
        "WIFI/rnd_mac_addr.c",
        "WIFI/debug.c",
    ],
    hdrs = [
        ":sprdwl_ng_headers",
        ":uwe5621_bsp_headers",
        "//common_drivers:soc_headers",
    ],
    local_defines = [
        "UWE5621_FTR",
        "IBSS_SUPPORT",
