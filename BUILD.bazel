        "RND_MAC_SUPPORT",
        "ATCMD_ASSERT",
        "TCPACK_DELAY_SUPPORT",
        "RX_NAPI",
        "SPRD_RX_THREAD",
        "OTT_UWE",
        "CP2_RESET_SUPPORT",
        "PPPOE_LLC_SUPPORT",
        "WOW_SUPPORT",
    ],
    copts = [
        "-Wno-date-time",
        "-Wno-implicit-fallthrough",
    ],
    out = "sprdwl_ng.ko",
    kconfig = "ddk_kconfig.sprdwl_ng",
    kernel_build = "//common_drivers:amlogic",
    visibility = ["//visibility:public"],
    deps = [
        ":uwe5621_bsp_sdio",
    ],
)
